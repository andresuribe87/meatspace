{
  "name": "meatspace",
  "private": true,
  "version": "0.2.0",
  "description": "meatspace.sh: twin-first sim-to-real verification. Twin Gap Reports and calibrated twins from public LeRobot data.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-reports.ts",
    "dev": "vite",
    "prebuild": "node scripts/sync-reports.ts",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && npm run db:migrate:remote && wrangler deploy && npm run deploy:www",
    "cf-typegen": "wrangler types",
    "deploy:www": "wrangler deploy -c www/wrangler.jsonc",
    "sync:reports": "node scripts/sync-reports.ts",
    "check:reports": "node scripts/sync-reports.ts --check"
  },
  "dependencies": {
    "hono": "^4.13.14",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@cloudflare/vite-plugin": "^1.66.0",
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
